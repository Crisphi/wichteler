<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css"
        integrity="sha384-AYmEC3Yw5cVb3ZcuHtOA93w35dYTsvhLPVnYs9eStHfGJvOvKxVfELGroGkvsg+p" crossorigin="anonymous" />
    <link rel="stylesheet" href="/assets/css/styles.css">
    <title>Registrierung & Login</title>
</head>

<body>
    <div class="register-login-container">

        <div class="register-login">
            <form action="/login" method="post" class="log-in-form">
                <h2>Einloggen</h2>
                <div class="input-field">
                    <i class="fas fa-user"></i>
                    <input type="text" name="user_email" id="user_email" placeholder="beispiel@gmail.com">
                </div>
                <div class="input-field">
                    <i class="fas fa-lock"></i>
                    <input type="text" name="user_password" id="user_password" placeholder="...">
                </div>
                <input type="submit" value="Login" class="btn">              
            </form>

            <form action="/register" method="post" class="sign-up-form">
                <div class="sign-up-input">
                    <h2>Registrieren</h2>
                    <div class="input-field">
                        <i class="fas fa-user"></i>
                        <input type="text" name= "username" placeholder="Name fürs Wichteln">
                    </div>
                    <div class="input-field">
                        <i class="fas fa-user"></i>
                        <input type="text" name= "pronouns" placeholder="Pronomen">
                    </div>
                    <div class="input-field">
                        <i class="fas fa-envelope"></i>
                        <input type="text" name="email" placeholder="Email">
                    </div>
                    <div class="input-field">
                        <i class="fas fa-lock"></i>
                        <input type="text" name="password" placeholder="Passwort">
                    </div>
                    <div class="input-field">
                        <i class="fas fa-address-book"></i>
                        <input type="text" name="given_name" placeholder="Name für Adresse">
                    </div>
                    <div class="input-field">
                        <i class="fa-solid fa-house"></i>
                        <input type="text" name="address" placeholder="Adresse">
                    </div>
                    <div class="input-field">
                        <i class="fa fa-house"></i>
                        <input type="text" name="plz" placeholder="PLZ">
                    </div>
                    <div class="input-field">
                        <i class="fas fa-house"></i>
                        <input type="text" name="city" placeholder="Stadt">
                    </div>
                    
                    
                </div>

                <div class="sign-up-btn-grid">
                    <input type="submit" value="Sign up" class="btn">
                </div>
                
            </form>
        </div>
        <div class="panels-container">
            <div class="panel left-panel">
                <div class="content">
                    <h3>Schon registriert?</h3>
                    
                    <button class="btn-register" id="sign-in-btn">Einloggen</button>
                   

                </div>

            </div>
            <div class="panel right-panel">
                <div class="content">
                    <h3>Noch nicht registriert?</h3>
                   
                    <button class="btn-register" id="sign-up-btn">Registrieren</button>
                   

                </div>
            </div>
        </div>
    </div>
    <script src="/assets/javascript/login.js"></script>
</body>

</html>